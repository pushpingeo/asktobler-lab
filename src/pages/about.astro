---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../layouts/Base.astro";
import AboutBody from "../components/islands/AboutBody.astro";
import { islands } from "../lib/islands";
import { getPage } from "../lib/tina";
const page = (await getPage("about")).data.pages;
---
<Base title={"title" in page ? page.title : "About"} description={"description" in page ? page.description ?? undefined : undefined}>
  <TinaIsland name="about" wrapper={islands.about.wrapper} primary>
    <AboutBody page={page} />
  </TinaIsland>
</Base>
