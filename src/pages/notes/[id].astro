---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Map from "../../components/Map.astro";
import { getNotes, formatDate } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
---
<Base title={d.title} description={d.summary}>
  <article class="wrap note">
    <header>
      <p class="meta ui"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>, {d.kind}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>
    {d.map && (
      <figure class="lead-map">
        <Map name={d.map} />
        {d.mapCaption && <figcaption class="ui">{d.mapCaption}</figcaption>}
      </figure>
    )}
    <div class="prose"><Content /></div>
    <p class="back ui"><a href="/notes">All notes</a></p>
  </article>
</Base>
<style>
  .note header { max-width: 44rem; margin: 1.5rem 0 2rem; }
  .meta { color: var(--ink-soft); margin-bottom: 0.6rem; }
  .summary { font-size: 1.3rem; font-style: italic; color: var(--ink-soft); margin-top: 1rem; }
  .lead-map { margin: 0 0 2.5rem; max-width: 44rem; }
  .lead-map :global(.map-wrap) { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 3px; }
  .lead-map :global(svg) { height: 100%; }
  .lead-map figcaption { color: var(--ink-soft); margin-top: 0.6rem; }
  .back { margin-top: 3rem; }
</style>
