---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../../layouts/Base.astro";
import NoteBody from "../../components/islands/NoteBody.astro";
import { islands } from "../../lib/islands";
import { getNotes } from "../../lib/notes";
import { getNote } from "../../lib/tina";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id } }));
}
const slug = Astro.params.id!;
const note = (await getNote(slug)).data.notes;
---
<Base title={note.title} description={note.summary}>
  <article class="wrap note">
    <TinaIsland name="note" wrapper={islands.note.wrapper} params={{ slug }} primary>
      <NoteBody note={note} />
    </TinaIsland>
    <p class="back ui"><a href="/notes">All notes</a></p>
  </article>
</Base>
<style>
  .back { margin-top: 3rem; }
</style>
