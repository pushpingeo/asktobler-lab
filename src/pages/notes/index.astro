---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../../layouts/Base.astro";
import NoteList from "../../components/NoteList.astro";
import SectionIntro from "../../components/islands/SectionIntro.astro";
import { islands } from "../../lib/islands";
import { getNotes } from "../../lib/notes";
import { getPage } from "../../lib/tina";
const notes = await getNotes();
const page = (await getPage("notes")).data.pages;
---
<Base title={"title" in page ? page.title : "Notes"} description={"description" in page ? page.description ?? undefined : undefined}>
  <section class="wrap">
    <TinaIsland name="section" wrapper={islands.section.wrapper} params={{ page: "notes" }} primary>
      <SectionIntro page={page} />
    </TinaIsland>
    <NoteList notes={notes} />
  </section>
</Base>
