---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../../layouts/Base.astro";
import ArchivePostBody from "../../components/islands/ArchivePostBody.astro";
import { islands } from "../../lib/islands";
import { getArchive, formatDate } from "../../lib/notes";
import { getArchivePost } from "../../lib/tina";

export async function getStaticPaths() {
  const posts = await getArchive();
  return posts.map((post) => {
    const same = posts.filter((p) => p.data.source === post.data.source);
    const i = same.indexOf(post);
    const link = (p?: typeof post) => p && { id: p.id, title: p.data.title };
    return { params: { id: post.id }, props: { prev: link(same[i - 1]), next: link(same[i + 1]) } };
  });
}
const { prev, next } = Astro.props;
const slug = Astro.params.id!;
const post = (await getArchivePost(slug)).data.archive;
const where = post.source === "linkedin" ? "LinkedIn" : "the Spatial Miscellany";
---
<Base title={post.title} description={`From ${where}, ${formatDate(new Date(post.date))}.`}>
  <article class="wrap">
    <TinaIsland name="archive-post" wrapper={islands["archive-post"].wrapper} params={{ slug }} primary>
      <ArchivePostBody post={post} />
    </TinaIsland>
    <nav class="pager ui" aria-label="More from the archive">
      {prev ? <a href={`/archive/${prev.id}`}>Older: {prev.title}</a> : <span />}
      {next ? <a href={`/archive/${next.id}`}>Newer: {next.title}</a> : <span />}
    </nav>
  </article>
</Base>
<style>
  .pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; max-width: var(--measure); font-weight: 600; }
  .pager a:last-child { text-align: right; }
</style>
