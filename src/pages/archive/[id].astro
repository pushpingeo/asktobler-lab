---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getArchive, formatDate } from "../../lib/notes";

export async function getStaticPaths() {
  const posts = await getArchive();
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, prev: posts[i - 1], next: posts[i + 1] } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={`From the Spatial Miscellany, ${formatDate(d.date)}.`}>
  <article class="wrap">
    <header>
      <p class="meta ui"><a href="/archive">Archive</a>: from the Spatial Miscellany, {formatDate(d.date)}</p>
      <h1>{d.title}</h1>
    </header>
    <div class="prose"><Content /></div>
    <p class="note ui">Kept as originally written. Images haven't survived, and links go to archived copies. <a href={d.original}>See the original page</a>.</p>
    <nav class="pager ui" aria-label="More from the archive">
      {prev ? <a href={`/archive/${prev.id}`}>Older: {prev.data.title}</a> : <span />}
      {next ? <a href={`/archive/${next.id}`}>Newer: {next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>
<style>
  header { max-width: 44rem; margin: 1.5rem 0 2rem; }
  .meta { color: var(--ink-soft); margin-bottom: 0.8rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .note { max-width: var(--measure); margin-top: 2.5rem; padding: 0.9rem 1.1rem; background: var(--tint); border-radius: 10px; color: var(--ink-soft); }
  .pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; max-width: var(--measure); font-weight: 600; }
  .pager a:last-child { text-align: right; }
</style>
