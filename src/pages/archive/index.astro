---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../../layouts/Base.astro";
import ArchiveIndex from "../../components/islands/ArchiveIndex.astro";
import { islands } from "../../lib/islands";
import { getPage, listArchive } from "../../lib/tina";
const page = (await getPage("archive")).data.pages;
const posts = await listArchive();
---
<Base title={"title" in page ? page.title : "Archive"} description={"description" in page ? page.description ?? undefined : undefined}>
  <TinaIsland name="archive-index" wrapper={islands["archive-index"].wrapper} primary>
    <ArchiveIndex page={page} posts={posts} />
  </TinaIsland>
</Base>
