---
import Base from "../../layouts/Base.astro";
import { getArchive, formatDate } from "../../lib/notes";
const posts = await getArchive();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="Archive" description="Posts from the Spatial Miscellany, a geospatial blog from 2007 to 2010.">
  <section class="wrap">
    <h1>Archive</h1>
    <div class="intro">
      <p>Before this lab there was the Spatial Miscellany, a blog I kept from about 2005 to 2010. It was mostly about open data, the geoweb, and whatever I'd been tinkering with at the weekend.</p>
      <p>These posts were recovered from the Internet Archive and are kept as written, typos and all. The images didn't survive. Links go to archived copies, since most of the sites have gone.</p>
    </div>
    {years.map((y) => (
      <section class="year">
        <h2>{y}</h2>
        <ol class="list">
          {posts.filter((p) => p.data.date.getFullYear() === y).map((p) => (
            <li>
              <a href={`/archive/${p.id}`}>{p.data.title}</a>
              <span class="ui date">{formatDate(p.data.date)}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</Base>
<style>
  h1 { margin: 1.5rem 0 1rem; }
  .intro { font-size: 1.15rem; max-width: 36rem; margin-bottom: 2.5rem; color: var(--ink-soft); }
  .year { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: 1.4rem 0; border-top: 1px solid var(--rule); }
  .year h2 { font-size: 1.6rem; }
  .list { list-style: none; margin: 0; padding: 0; max-width: 40rem; }
  .list li { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: 0.35rem 0; }
  .list a { font-weight: 600; text-decoration: none; }
  .list a:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  .date { color: var(--ink-soft); white-space: nowrap; }
  @media (max-width: 40rem) {
    .year { grid-template-columns: 1fr; gap: 0.4rem; }
    .list li { flex-direction: column; gap: 0; padding: 0.5rem 0; }
  }
</style>
