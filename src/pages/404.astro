---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../layouts/Base.astro";
import SectionIntro from "../components/islands/SectionIntro.astro";
import { islands } from "../lib/islands";
import { getPage } from "../lib/tina";
const page = (await getPage("not-found")).data.pages;
---
<Base title="Not found">
  <section class="wrap" style="margin-top:2rem">
    <TinaIsland name="section" wrapper={islands.section.wrapper} params={{ page: "not-found" }} primary>
      <SectionIntro page={page} />
    </TinaIsland>
  </section>
</Base>
