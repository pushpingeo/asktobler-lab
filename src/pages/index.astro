---
import Base from "../layouts/Base.astro";
import Map from "../components/Map.astro";
import ProjectRow from "../components/ProjectRow.astro";
import NoteList from "../components/NoteList.astro";
import { projects } from "../data/projects";
import { SITE } from "../site.config";
import { getNotes, getArchive, formatDate } from "../lib/notes";

const notes = (await getNotes()).slice(0, 4);
const archivePicks = ["faster-web-mapping-chrome", "pipes", "gis-software-above-a-single-device"];
const archive = (await getArchive()).filter((p) => archivePicks.includes(p.id));
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>{SITE.tagline}</h1>
      <p class="lede">
        A small, open lab for experiments in what happens when AI becomes the way in to
        geography. Most of them run in your browser, on open data.
      </p>
      <p class="lede">Some work. Some don't. Both get written up.</p>
      <p class="hero-links">
        <a class="btn" href="/projects">See the projects</a>
        <a class="btn btn-dark" href="/notes/why-a-lab">Why a lab</a>
      </p>
    </div>
    <figure class="hero-map">
      <Map name="north-sea" />
      <figcaption class="ui">
        <div class="key" aria-hidden="true">
          <span><i class="k-field"></i>Oil and gas fields</span>
          <span><i class="k-pipe"></i>Pipelines</span>
          <span><i class="k-wind"></i>Offshore wind</span>
          <span><i class="k-lic"></i>Licences</span>
          <span><i class="k-well"></i>Wells</span>
        </div>
        <p class="credit">The North Sea, drawn from open data: NSTA, The Crown Estate and Natural Earth.
        The same data sits behind <a href="/projects#three-engines">One question, three engines</a>.</p>
      </figcaption>
    </figure>
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>What I'm working on</h2>
      <a class="all" href="/projects">All projects</a>
    </div>
    {projects.slice(0, 3).map((p) => <ProjectRow project={p} />)}
  </section>

  <section class="wrap block">
    <div class="block-head">
      <h2>Latest notes</h2>
      <a class="all" href="/notes">All notes</a>
    </div>
    <NoteList notes={notes} />
  </section>

  <section class="wrap block archive">
    <div class="block-head">
      <h2>From the archive</h2>
      <a class="all" href="/archive">All archive posts</a>
    </div>
    <p class="archive-intro">Before this lab there was the Spatial Miscellany, a blog I kept from about 2005 to 2010. Some of it still holds up.</p>
    <ul class="picks">
      {archive.map((p) => (
        <li>
          <p class="ui year">{formatDate(p.data.date)}</p>
          <a href={`/archive/${p.id}`}>{p.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-top: clamp(1rem, 4vw, 3rem); }
  .hero h1 { margin-bottom: 1.8rem; max-width: 12ch; }
  .lede { font-size: 1.2rem; max-width: 30rem; color: var(--ink-soft); }
  .hero-links { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero-map { margin: 0; }
  .credit { margin: 0.6rem 0 0; max-width: 34rem; }
  .block { margin-top: clamp(4rem, 8vw, 6.5rem); }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.4rem; }
  .all { font-weight: 600; font-size: 0.95rem; }
  .archive-intro { color: var(--ink-soft); max-width: 34rem; margin-bottom: 1.6rem; }
  .picks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .picks li { background: var(--tint); border-radius: 14px; padding: 1.3rem 1.4rem 1.5rem; }
  .picks .year { color: var(--ink-soft); margin: 0 0 0.5rem; }
  .picks a { font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; line-height: 1.25; text-decoration: none; }
  .picks a:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  @media (max-width: 52rem) {
    .picks { grid-template-columns: 1fr; }
    .hero { grid-template-columns: 1fr; }
    .hero h1 { max-width: 16ch; }
  }
</style>
