---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../layouts/Base.astro";
import Map from "../components/Map.astro";
import ProjectRow from "../components/ProjectRow.astro";
import NoteList from "../components/NoteList.astro";
import HomeHero from "../components/islands/HomeHero.astro";
import HomeMapCaption from "../components/islands/HomeMapCaption.astro";
import BlockHead from "../components/islands/BlockHead.astro";
import { islands } from "../lib/islands";
import { getNotes } from "../lib/notes";
import { getPage, getSettings, getProject, listProjects } from "../lib/tina";

const notes = (await getNotes()).slice(0, 4);
const page = (await getPage("home")).data.pages;
const settings = (await getSettings()).data.settings;
const projects = await Promise.all((await listProjects()).slice(0, 3).map(async (slug) => (await getProject(slug)).data.projects));
---
<Base>
  <section class="hero wrap">
    <TinaIsland name="home-hero" wrapper={islands["home-hero"].wrapper} primary>
      <HomeHero page={page} settings={settings} />
    </TinaIsland>
    <figure class="hero-map">
      <Map name="north-sea" />
      <TinaIsland name="home-map" wrapper={islands["home-map"].wrapper}>
        <HomeMapCaption page={page} />
      </TinaIsland>
    </figure>
  </section>

  <section class="wrap block">
    <TinaIsland name="block-head" wrapper={islands["block-head"].wrapper} params={{ which: "projects" }}>
      <BlockHead page={page} which="projects" />
    </TinaIsland>
    {projects.map((p) => (
      <TinaIsland name="project" wrapper={islands.project.wrapper} params={{ slug: p._sys.filename, detail: 0 }}>
        <ProjectRow project={p} />
      </TinaIsland>
    ))}
  </section>

  <section class="wrap block">
    <TinaIsland name="block-head" wrapper={islands["block-head"].wrapper} params={{ which: "notes" }}>
      <BlockHead page={page} which="notes" />
    </TinaIsland>
    <NoteList notes={notes} />
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-top: clamp(1rem, 4vw, 3rem); }
  .hero-map { margin: 0; }
  .block { margin-top: clamp(4rem, 8vw, 6.5rem); }
  .block :global(.block-head) { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.4rem; }
  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; }
  }
</style>
