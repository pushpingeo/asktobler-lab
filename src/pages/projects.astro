---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import SectionIntro from "../components/islands/SectionIntro.astro";
import { islands } from "../lib/islands";
import { getPage, getProject, listProjects } from "../lib/tina";
const page = (await getPage("projects")).data.pages;
const projects = await Promise.all((await listProjects()).map(async (slug) => (await getProject(slug)).data.projects));
---
<Base title={"title" in page ? page.title : "Projects"} description={"description" in page ? page.description ?? undefined : undefined}>
  <section class="wrap">
    <TinaIsland name="section" wrapper={islands.section.wrapper} params={{ page: "projects" }} primary>
      <SectionIntro page={page} />
    </TinaIsland>
    {projects.map((p) => (
      <TinaIsland name="project" wrapper={islands.project.wrapper} params={{ slug: p._sys.filename, detail: 1 }}>
        <ProjectRow project={p} detail />
      </TinaIsland>
    ))}
  </section>
</Base>
