---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
---
<Base title="Projects" description="Working experiments in geography and AI: live demos, tools and evaluations.">
  <section class="wrap">
    <h1>Projects</h1>
    <p class="intro">Each one sets out to show a single thing. Most run in your browser on open data, and the code is all on GitHub.</p>
    {projects.map((p) => <ProjectRow project={p} detail />)}
  </section>
</Base>
<style>
  h1 { margin: 1.5rem 0 1rem; }
  .intro { font-size: 1.2rem; max-width: 34rem; margin-bottom: 2.5rem; }
</style>
