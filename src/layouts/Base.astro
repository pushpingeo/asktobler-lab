---
import "../styles/global.css";
import "../styles/maps.css";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Header from "../components/islands/Header.astro";
import Footer from "../components/islands/Footer.astro";
import { getSettings } from "../lib/tina";
import { islands } from "../lib/islands";

interface Props { title?: string; description?: string }
const settings = (await getSettings()).data.settings;
const { title, description = settings.description ?? "" } = Astro.props;
const fullTitle = title ? `${title} | ${settings.name}` : `${settings.name}: ${settings.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, "https://asktobler.ai");
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${settings.name} notes`} href="/rss.xml" />
    <meta property="og:title" content={title ?? settings.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    {!settings.launched && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TinaIsland name="header" wrapper={islands.header.wrapper} params={{ path }}>
      <Header settings={settings} path={path} />
    </TinaIsland>
    <main id="main"><slot /></main>
    <TinaIsland name="footer" wrapper={islands.footer.wrapper}>
      <Footer settings={settings} />
    </TinaIsland>
  </body>
</html>
