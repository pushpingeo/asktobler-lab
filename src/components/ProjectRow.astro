---
import Map from "./Map.astro";
import type { Project } from "../data/projects";
interface Props { project: Project; detail?: boolean }
const { project: p, detail = false } = Astro.props;
---
<article class="project" id={p.slug}>
  <Map name={p.map} class="thumb" />
  <div class="project-text">
    <p class="status ui" data-status={p.status}>{p.status}</p>
    <h3>{p.title}</h3>
    <p class="point">{p.point}</p>
    {detail && <p class="body">{p.body}</p>}
    {(p.links.length > 0 || p.note) && (
      <p class="links ui">
        {p.links.map((l) => <a href={l.href}>{l.label}</a>)}
        {p.note && <a href={`/notes/${p.note}`}>Read the note</a>}
      </p>
    )}
  </div>
</article>

<style>
  .project { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 1.6rem; align-items: start; padding: 1.8rem 0; border-top: 1px solid var(--depth); }
  .project h3 { margin-bottom: 0.45rem; }
  .point { font-style: italic; font-size: 1.1rem; color: var(--ink-soft); }
  .body { max-width: var(--measure); }
  .status { margin: 0 0 0.35rem; color: var(--ink-soft); }
  .status[data-status="Live"] { color: var(--magenta); }
  .status[data-status="Live"]::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--magenta); margin-right: 0.45rem; vertical-align: 0.1em; }
  .links { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 0.9rem; margin: 0; }
  @media (max-width: 40rem) {
    .project { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
