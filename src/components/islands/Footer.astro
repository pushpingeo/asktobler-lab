---
import { tinaField } from "@tinacms/astro/tina-field";
import type { Settings } from "../../lib/tina";
interface Props { settings: Settings }
const { settings: s } = Astro.props;
---
<div class="wrap">
  <div>
    <p class="foot-name" data-tina-field={tinaField(s, "name")}>{s.name}</p>
    <p class="ui" data-tina-field={tinaField(s, "footerNote")}>{s.footerNote}</p>
  </div>
  <nav class="ui" aria-label="Elsewhere">
    {s.github && <a href={s.github} data-tina-field={tinaField(s, "github")}>GitHub</a>}
    {s.linkedin && <a href={s.linkedin} data-tina-field={tinaField(s, "linkedin")}>LinkedIn</a>}
    {s.email && <a href={`mailto:${s.email}`} data-tina-field={tinaField(s, "email")}>Email</a>}
    <a href="/archive">Archive</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</div>
