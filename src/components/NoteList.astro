---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/notes";
interface Props { notes: CollectionEntry<"notes">[] }
const { notes } = Astro.props;
---
{notes.length === 0 ? (
  <p>Nothing here yet. The first notes are on their way.</p>
) : (
  <ol class="notes">
    {notes.map((n) => (
      <li>
        <p class="meta ui"><time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>, {n.data.kind}</p>
        <h3><a href={`/notes/${n.id}`}>{n.data.title}</a></h3>
        <p class="summary">{n.data.summary}</p>
      </li>
    ))}
  </ol>
)}

<style>
  .notes { list-style: none; margin: 0; padding: 0; }
  .notes li { padding: 1.5rem 0; border-top: 1px solid var(--rule); max-width: 44rem; }
  .meta { margin: 0 0 0.3rem; color: var(--ink-soft); }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--blue); text-decoration: underline; }
  .summary { margin: 0.45rem 0 0; color: var(--ink-soft); }
</style>
