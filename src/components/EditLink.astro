---
// "Edit this page" link that opens the article's Markdown file in GitHub's editor.
// Hidden for everyone by default. Visit any page with ?edit=1 once to switch it on
// in that browser (it's remembered), and ?edit=0 to switch it off again.
const { file } = Astro.props as { file?: string };
const repo = "https://github.com/pushpingeo/asktobler-lab";
const href = file ? `${repo}/edit/main/${file.replace(/^\.\//, "")}` : undefined;
---
{href && (
  <p class="edit-link ui" hidden>
    <a href={href} target="_blank" rel="noopener">Edit this page on GitHub</a>
  </p>
)}
<script is:inline>
  (function () {
    try {
      var q = new URLSearchParams(location.search).get("edit");
      if (q === "1") localStorage.setItem("lab-edit", "1");
      if (q === "0") localStorage.removeItem("lab-edit");
      if (localStorage.getItem("lab-edit") === "1") {
        document.querySelectorAll(".edit-link").forEach(function (el) { el.hidden = false; });
      }
    } catch (e) {}
  })();
</script>
<style>
  .edit-link { max-width: var(--measure); margin-top: 2rem; }
  .edit-link a { font-weight: 600; }
</style>
